<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.14.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" PrivateAssets="all" />
    <ProjectReference Include="$(RecoveryAuthRoot)/Legacy.Maliev.AuthService.Infrastructure/Legacy.Maliev.AuthService.Infrastructure.csproj" />
    <ProjectReference Include="$(RecoveryAuthRoot)/Legacy.Maliev.AuthService.Api/Legacy.Maliev.AuthService.Api.csproj" Aliases="AuthApi" />
    <ProjectReference Include="$(RecoveryIntranetRoot)/Legacy.Maliev.Intranet.Bff/Legacy.Maliev.Intranet.Bff.csproj" Aliases="BffApi" />
    <ProjectReference Include="$(RecoveryNotificationRoot)/Legacy.Maliev.NotificationService.Api/Legacy.Maliev.NotificationService.Api.csproj" Aliases="NotificationApi" />
  </ItemGroup>
  <Target Name="RequireReviewedAuthSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RecoveryAuthRoot)' == ''" Text="RecoveryAuthRoot must identify the reviewed ordinary Auth recovery candidate." />
    <Error Condition="'$(RecoveryIntranetRoot)' == '' Or '$(RecoveryNotificationRoot)' == ''" Text="Reviewed Intranet and Notification source roots are required." />
  </Target>
</Project>
